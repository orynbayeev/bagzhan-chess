{
 "rewrites": [
  {
   "source": "/lib/chess.js",
   "destination": "https://cdn.jsdelivr.net/npm/chess.js@1.4.0/dist/esm/chess.js"
  },
  {
   "source": "/pieces.css",
   "destination": "https://cdn.jsdelivr.net/npm/chessground@9.2.1/assets/chessground.cburnett.css"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/engine/(.*).wasm",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/wasm"
    }
   ]
  }
 ]
}